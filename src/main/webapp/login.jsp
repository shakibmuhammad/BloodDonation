<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ include file="/WEB-INF/jspf/lang.jspf" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><c:set var="pageTitleKey" scope="request" value="login.pageTitle"/><jsp:include page="/includes/header.jsp"/>
<main id="main" class="page-main"><section class="login-layout container"><div class="login-art"><span class="large-drop"><svg viewBox="0 0 100 120" aria-hidden="true"><path d="M50 4C38 26 10 57 10 79a40 40 0 0 0 80 0C90 57 62 26 50 4Z" fill="currentColor"/><path d="M31 79c0 12 8 20 20 22" fill="none" stroke="#fff" stroke-linecap="round" stroke-width="7"/></svg></span><p class="eyebrow"><fmt:message key="login.eyebrow"/></p><h1><fmt:message key="login.headline"/></h1><p><fmt:message key="login.intro"/></p></div><div class="panel login-panel"><p class="eyebrow"><fmt:message key="login.accountType"/></p><h2><fmt:message key="login.heading"/></h2><c:if test="${param.registered eq '1'}"><p class="alert alert-success"><fmt:message key="login.registered"/></p></c:if><c:if test="${not empty error}"><p class="alert alert-error"><c:out value="${error}"/></p></c:if><form method="post" action="${pageContext.request.contextPath}/login" data-validate><input type="hidden" name="csrfToken" value="<c:out value='${csrfToken}'/>"/><input type="hidden" name="returnTo" value="<c:out value='${param.returnTo}'/>"/><label><fmt:message key="login.identityLabel"/><input name="identity" type="text" autocomplete="username" autocapitalize="none" spellcheck="false" required></label><label><fmt:message key="login.passwordLabel"/><input type="password" name="password" autocomplete="current-password" required></label><button class="button button-block" type="submit"><fmt:message key="login.submit"/></button></form><p class="form-foot"><fmt:message key="login.newHere"/> <a href="${pageContext.request.contextPath}/register"><fmt:message key="login.createProfile"/></a></p></div></section></main><jsp:include page="/includes/footer.jsp"/>
